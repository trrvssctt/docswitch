<?xml version="1.0" encoding="utf-8"?>
<!--
  Le serveur DocSwitch n'a pas de nom de domaine : il utilise un certificat auto-signé.
  On ne fait confiance qu'à CE certificat (res/raw/docswitch_server.crt), et seulement pour
  cette adresse. Tout le reste utilise les autorités système habituelles, sans HTTP en clair.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">185.215.165.43</domain>
        <trust-anchors>
            <certificates src="@raw/docswitch_server" />
        </trust-anchors>
    </domain-config>
</network-security-config>
